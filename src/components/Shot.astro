---
// A window screenshot of the app, swapping to the dark skin's capture in dark mode.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  light: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  sizes: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  widths?: number[];
}

const { light, dark, alt, sizes, class: className, loading = 'lazy' } = Astro.props;
const widths = (Astro.props.widths ?? [640, 960, 1280, 1800, 2480]).filter((w) => w <= light.width);
if (!widths.includes(light.width) && light.width < 2480) widths.push(light.width);

async function srcset(image: ImageMetadata) {
  const out = await Promise.all(widths.map((width) => getImage({ src: image, width, format: 'webp', quality: 82 })));
  return out.map((img, i) => `${img.src} ${widths[i]}w`).join(', ');
}

const lightSet = await srcset(light);
const darkSet = dark ? await srcset(dark) : null;
const fallback = await getImage({ src: light, width: Math.min(1280, light.width), format: 'webp', quality: 82 });
---
<picture class={className}>
  {darkSet && <source media="(prefers-color-scheme: dark)" srcset={darkSet} sizes={sizes} />}
  <source srcset={lightSet} sizes={sizes} />
  <img
    src={fallback.src}
    alt={alt}
    width={light.width / 2}
    height={light.height / 2}
    loading={loading}
    decoding="async"
  />
</picture>
